# ============================================================
# MediZano POS - Variables de Entorno de Ejemplo (.env.example)
# ============================================================
# Copie este archivo como '.env' en la raíz y complete con sus valores reales.
# IMPORTANTE: Nunca suba su archivo '.env' a repositorios Git públicos o privados.

# --- Base de Datos PostgreSQL ---
POSTGRES_DB=medizano_master_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here

# --- Seguridad y Autenticación JWT ---
JWT_SECRET=replace_with_at_least_32_random_bytes
MEDIZANO_DEFAULT_PASSWORD=replace_with_a_strong_initial_password
INTERNAL_SERVICE_TOKEN=replace_with_a_random_internal_token_of_at_least_32_chars

# --- Correo transaccional SpaceMail ---
# Se usa para comprobantes de venta y alertas a proveedores.
SPRING_MAIL_HOST=mail.spacemail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=medizano@univer.lat
SPRING_MAIL_PASSWORD=replace_with_your_spacemail_password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# --- Culqi DEVS / Sandbox (nunca usar llaves live) ---
CULQI_PUBLIC_KEY=pk_test_replace_me
CULQI_SECRET_KEY=sk_test_replace_me
# Configúrala en CulqiPanel cuando tengas un dominio HTTPS público.
CULQI_WEBHOOK_SECRET=
CULQI_API_BASE_URL=https://api.culqi.com/v2

# --- Suite de Observabilidad: Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_secure_admin_password_here
