{$MEDIZANO_DOMAIN}, www.{$MEDIZANO_DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    # Reject common secret-file and control-panel probes before they reach the
    # Angular SPA fallback. ACME paths remain available to Caddy internally.
    @blocked path /.env /.env.* /.git* /.svn* /.hg* /.DS_Store /server-status /wp-admin* /wp-login.php /xmlrpc.php /phpmyadmin* /console* /@vite/* /v2/_catalog
    respond @blocked 404

    # The frontend container owns its HTTPS-only security policy.  Caddy
    # terminates the public certificate and connects to that internal TLS
    # listener; its certificate is private to Docker, hence verification is
    # intentionally skipped only on this internal network hop.
    reverse_proxy https://frontend:443 {
        transport http {
            tls_insecure_skip_verify
        }
    }

    log {
        output stdout
        format console
    }
}

# Paneles operativos: se exponen por subdominio y requieren autenticación.
# La contraseña se guarda solamente como hash bcrypt en el archivo .env del servidor.
(observability_auth) {
    basic_auth {
        ops {$OBSERVABILITY_PASSWORD_HASH}
    }
}

grafana.{$MEDIZANO_DOMAIN} {
    import observability_auth
    reverse_proxy grafana:3000
}

prometheus.{$MEDIZANO_DOMAIN} {
    import observability_auth
    reverse_proxy prometheus:9090
}

kafka.{$MEDIZANO_DOMAIN} {
    import observability_auth
    reverse_proxy kafka-ui:8080
}

eureka.{$MEDIZANO_DOMAIN} {
    import observability_auth
    reverse_proxy eureka-server:8761
}
